# Local development defaults only. Never commit real credentials.
NODE_ENV=development
KHLIM_ENV=development
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_KHLIM_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
NEXT_PUBLIC_CONTACT_EMAIL=

# Public seller/business disclosures. These values are intentionally public and
# must be completed accurately before enabling online academy checkout.
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=KH LIM BASKETBALL SDN. BHD.
NEXT_PUBLIC_BUSINESS_REGISTRATION_NO=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
# Dedicated official KHLIM WhatsApp number (E.164 or MY mobile, e.g. +60123456789).
# Leave blank if WhatsApp is not yet configured; never assume NEXT_PUBLIC_BUSINESS_PHONE supports WhatsApp.
NEXT_PUBLIC_KHLIM_WHATSAPP_NUMBER=

# Do not set this to 1 until every KHero promotional image is verified in
# media/RIGHTS-MANIFEST.md with ownership/licence and any required people/minor
# publication-consent evidence held in a private business record.
NEXT_PUBLIC_KHERO_MEDIA_RIGHTS_CONFIRMED=0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khlim
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-development-anon-key
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-development-anon-key
# Organization #001 compatibility defaults. Keep external organization runtime
# disabled until organization-owned Academy/member data is tenant-scoped.
KHLIM_DEFAULT_ORGANIZATION_SLUG=khlim-basketball
KHLIM_MULTI_ORGANIZATION_ENABLED=false
# Server-authoritative launch gates for deferred customer features. The API
# enables a feature only when the value is exactly 1; anything else (unset,
# "true", "0") keeps it closed. NEXT_PUBLIC_* browser flags never authorize the
# API — set them to mirror these values for presentation only.
KHLIM_ENABLE_V1_ENROLMENT=0
KHLIM_ENABLE_V1_PORTAL=0
PAYMENT_PROVIDER=billplz
BILLPLZ_SECRET_KEY=replace-with-billplz-sandbox-secret-key
BILLPLZ_COLLECTION_ID=replace-with-billplz-sandbox-collection-id
BILLPLZ_X_SIGNATURE_KEY=replace-with-billplz-sandbox-x-signature-key
BILLPLZ_SANDBOX=1
BILLPLZ_CALLBACK_URL=http://localhost:3001/v1/payments/webhooks/billplz
BILLPLZ_REDIRECT_URL=http://localhost:3000/portal/membership
# Optional: choose a direct gateway code such as an FPX bank code or BP-RHBQR for DuitNow QR.
# Leave blank to let the payer choose among payment methods enabled for the Billplz Collection.
BILLPLZ_DIRECT_GATEWAY_CODE=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Proxy trust is opt-in; no automatic Vercel trust or fixed hop count.
# Enable only after verifying the ingress topology and trusted peer IPs/CIDRs.
# TRUST_PROXY takes precedence over the legacy KHLIM_TRUST_PROXY flag.
TRUST_PROXY=false
# Required when TRUST_PROXY=true (example only; use your actual proxy addresses).
TRUST_PROXY_ADDRESSES=
