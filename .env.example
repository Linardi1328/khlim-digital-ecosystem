# Local development defaults only. Never commit real credentials.
NODE_ENV=development
KHLIM_ENV=development
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_KHLIM_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
NEXT_PUBLIC_CONTACT_EMAIL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/khlim
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-development-anon-key
SUPABASE_JWT_ISSUER=https://example.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-development-anon-key
PAYMENT_PROVIDER=billplz
BILLPLZ_SECRET_KEY=replace-with-billplz-sandbox-secret-key
BILLPLZ_COLLECTION_ID=replace-with-billplz-sandbox-collection-id
BILLPLZ_X_SIGNATURE_KEY=replace-with-billplz-sandbox-x-signature-key
BILLPLZ_SANDBOX=1
BILLPLZ_CALLBACK_URL=http://localhost:3001/v1/payments/webhooks/billplz
BILLPLZ_REDIRECT_URL=http://localhost:3000/payment/confirmation
# Optional: choose a direct gateway code such as an FPX bank code or BP-RHBQR for DuitNow QR.
# Leave blank to let the payer choose among payment methods enabled for the Billplz Collection.
BILLPLZ_DIRECT_GATEWAY_CODE=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
