# Template only. Real production values belong in provider secret/config stores.
NODE_ENV=production
KHLIM_ENV=production
PORT=3001

# API ingress / browser origins.
CORS_ALLOWED_ORIGINS=https://web.example.invalid,https://admin.example.invalid

# Public Web configuration.
NEXT_PUBLIC_KHLIM_ENV=production
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/v1
NEXT_PUBLIC_SUPABASE_URL=https://production-project.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-in-provider-config
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=KH LIM BASKETBALL SDN. BHD.
NEXT_PUBLIC_BUSINESS_REGISTRATION_NO=replace-with-public-registration-number
NEXT_PUBLIC_BUSINESS_ADDRESS=replace-with-public-business-address
NEXT_PUBLIC_BUSINESS_EMAIL=replace-with-public-business-email
NEXT_PUBLIC_BUSINESS_PHONE=replace-with-public-business-phone

# Server-side database/auth configuration.
DATABASE_URL=replace-in-secret-store
SUPABASE_URL=https://production-project.example.invalid
SUPABASE_ANON_KEY=replace-in-provider-config
SUPABASE_JWT_ISSUER=https://production-project.example.invalid/auth/v1

# Billplz live mode. Secret Key and X Signature Key are server-only secrets.
# Keep BILLPLZ_SANDBOX=1 in pre-alpha/staging deployments; set 0 only with
# approved live Billplz credentials and production KYB/merchant activation.
PAYMENT_PROVIDER=billplz
BILLPLZ_SANDBOX=0
BILLPLZ_SECRET_KEY=replace-in-secret-store
BILLPLZ_COLLECTION_ID=replace-with-production-collection-id
BILLPLZ_X_SIGNATURE_KEY=replace-in-secret-store
BILLPLZ_CALLBACK_URL=https://api.example.invalid/v1/payments/webhooks/billplz
BILLPLZ_REDIRECT_URL=https://web.example.invalid/portal/membership
BILLPLZ_DIRECT_GATEWAY_CODE=

SENTRY_DSN=replace-in-secret-store
NEXT_PUBLIC_SENTRY_DSN=replace-in-provider-config
