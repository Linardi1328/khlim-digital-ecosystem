  "info": {
    "title": "KHLIM API",
    "description": "Shared API for the KHLIM Digital Sports Ecosystem",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "supabase": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Supabase access token"
      }
    },
    "schemas": {
      "UpsertGuardianProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Alex Tan",
            "maxLength": 120
          },
          "phone": {
            "type": "object",
            "example": "+60123456789",
            "nullable": true
          }
        },
        "required": [
          "displayName"
        ]
      },
      "UpdatePreferencesDto": {
        "type": "object",
        "properties": {
          "preferredLocale": {
            "type": "string",
            "enum": [
              "en",
              "ms",
              "zh-Hans",
              "zh-Hant",
              "hi"
            ],
            "example": "en"
          }
        },
        "required": [
          "preferredLocale"
        ]
      },
      "CreateManagedAthleteDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Jamie Tan",
            "maxLength": 120
          },
          "dateOfBirth": {
            "type": "string",
            "example": "2014-06-12",
            "format": "date"
          },
          "preferredLocale": {
            "type": "string",
            "enum": [
              "en",
              "ms",
              "zh-Hans",
              "zh-Hant",
              "hi"
            ],
            "example": "en"
          },
          "relationshipType": {
            "type": "string",
            "example": "parent",
            "maxLength": 50
          }
        },
        "required": [
          "displayName",
          "dateOfBirth"
        ]
      },
      "UpdateAthleteDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Jamie Tan",
            "maxLength": 120
          },
          "dateOfBirth": {
            "type": "string",
            "example": "2014-06-12",
            "format": "date"
          },
          "preferredLocale": {
            "type": "string",
            "enum": [
              "en",
              "ms",
              "zh-Hans",
              "zh-Hant",
              "hi"
            ],
            "example": "en"
          }
        }
      },
      "CreateGuardianInvitationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "parent@example.com",
            "maxLength": 320
          },
          "relationshipType": {
            "type": "string",
            "example": "parent",
            "maxLength": 50
          }
        },
        "required": [
          "email"
        ]
      },
      "AcceptGuardianInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "One-time invitation token"
          }
        },
        "required": [
          "token"
        ]
      },
      "UpdateStaffRolesDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "UpdateAccountStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreatePendingMembershipDto": {
        "type": "object",
        "properties": {
          "offeringId": {
            "type": "string"
          },
          "planId": {
            "type": "string"
          }
        },
        "required": [
          "offeringId",
          "planId"
        ]
      },
      "CreateSportDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "BASKETBALL"
          },
          "defaultName": {
            "type": "string",
            "example": "Basketball"
          }
        },
        "required": [
          "code",
          "defaultName"
        ]
      },
      "CreateVenueDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Taylor's International School Puchong"
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateCourtDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Court 1"
          },
          "capacity": {
            "type": "number",
            "example": 30
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateProgrammeDto": {
        "type": "object",
        "properties": {
          "sportId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "U12-ACADEMY"
          },
          "name": {
            "type": "string",
            "example": "U12 Academy"
          },
          "description": {
            "type": "string"
          },
          "minimumAge": {
            "type": "number"
          },
          "maximumAge": {
            "type": "number"
          },
          "level": {
            "type": "string"
          }
        },
        "required": [
          "sportId",
          "code",
          "name"
        ]
      },
      "CreateProgrammeOfferingDto": {
        "type": "object",
        "properties": {
          "programmeId": {
            "type": "string"
          },
          "venueId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "U12 Saturday 10 AM"
          },
          "capacity": {
            "type": "number",
            "example": 30
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "OPEN",
              "CLOSED",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "programmeId",
          "name",
          "capacity"
        ]
      },
      "CreateMembershipPlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "6-Month Plan"
          },
          "durationMonths": {
            "type": "number",
            "example": 6
          },
          "commitmentCycles": {
            "type": "number",
            "example": 6
          },
          "billingFrequency": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "UPFRONT"
            ]
          },
          "recurringAmountMinor": {
            "type": "number",
            "description": "Minor currency units, e.g. sen"
          },
          "upfrontAmountMinor": {
            "type": "number",
            "description": "Minor currency units, e.g. sen"
          },
          "currency": {
            "type": "string",
            "example": "MYR"
          },
          "sessionAllowance": {
            "type": "number"
          },
          "benefitsSummary": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "billingFrequency"
        ]
      },
      "LinkPlanOfferingDto": {
        "type": "object",
        "properties": {
          "planId": {
            "type": "string"
          },
          "offeringId": {
            "type": "string"
          }
        },
        "required": [
          "planId",
          "offeringId"
        ]
      },
      "PrepareMembershipCheckoutDto": {
        "type": "object",
        "properties": {
          "acceptTerms": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "acceptTerms"
        ]
      }
    }
  }
}
